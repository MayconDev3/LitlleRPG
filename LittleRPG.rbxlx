      <Item class="ModuleScript" referent="RBX3871">
        <Properties>
          <string name="Name">Monetization</string>
          <ProtectedString name="Source">-- Entrega fixa e durável. Nenhuma oferta paga pode conceder raridade 7.
local Marketplace=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local C=require(game.ReplicatedStorage.LittleRPG.Config)
local P=require(game.ReplicatedStorage.LittleRPG.Progression)
local M={}
function M.Start(profiles,sync,notice)
 local offers={}
 for _,offer in ipairs(C.Products) do
  assert(offer.Rarity&lt;=6,"Ultra lendária não pode ser vendida por Robux")
  if offer.ProductId&gt;0 then assert(not offers[offer.ProductId],"ProductId duplicado"); offers[offer.ProductId]=offer end
 end
 Marketplace.ProcessReceipt=function(receipt)
  local pending=Enum.ProductPurchaseDecision.NotProcessedYet
  local player=Players:GetPlayerByUserId(receipt.PlayerId); local offer=offers[receipt.ProductId]
  if not player or not offer or profiles.Temporary or profiles.Travel[player] or profiles.Closing[player] or profiles.ReceiptBusy[player] then return pending end
  local d=profiles.Data[player]; if not d then return pending end
  profiles.ReceiptBusy[player]=true
  local ok,result=pcall(function()
   if not d.Receipts[receipt.PurchaseId] then
    local weapon=P.AddWeapon(d,offer.Blueprint,offer.Rarity)
    if not weapon then notice(player,"Libere espaço na mochila; sua compra será entregue depois."); return pending end
    d.Receipts[receipt.PurchaseId]=true
   end
   if not profiles.Save(player,false) then return pending end
   sync(player); notice(player,"Compra confirmada: "..offer.Name)
   return Enum.ProductPurchaseDecision.PurchaseGranted
  end)
  profiles.ReceiptBusy[player]=nil
  if not ok then warn("LittleRPG receipt failed",result); return pending end
  return result
 end
end
return M
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3872">
        <Properties>
          <string name="Name">Profiles</string>
          <ProtectedString name="Source">-- PERFIS: migração v1, trava de sessão, autosave e recibos no mesmo documento.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Http=game:GetService("HttpService")
local Shared=game.ReplicatedStorage:WaitForChild("LittleRPG")
local P=require(Shared.Progression)
local C=require(Shared.Config)
local K=require(Shared.Catalog)
local E=require(Shared.Economy)
local Profiles={Data={},Saving={},Closing={},Travel={},ReceiptBusy={}}
local store=game:GetService("DataStoreService"):GetDataStore("LittleRPG_Profiles_v1")
local token=game.JobId~="" and game.JobId or Http:GenerateGUID(false)
Profiles.Temporary=Run:IsStudio()
local function migrate(d)
 if not d.Version or d.Version&lt;2 then
  local old=d; d=P.New()
  for _,key in ipairs({"Level","XP","Gold","Floor","Unlocked","Bosses","Kills"}) do if old[key]~=nil then d[key]=old[key] end end
  d.Points=math.max(0,d.Level-1); d.LegacyOwned=old.Owned; d.Lock=old.Lock
  d.Bosses={alpha=old.Bosses and old.Bosses.warden or nil,warden=old.Bosses and old.Bosses.oracle or nil,sovereign=old.Bosses and old.Bosses.echo or nil}
  -- Preserve old inventory as new physical equivalents; no silent deletion.
  local map={"longsword","dagger","heavy_hammer","rapier","light_hammer"}
  for id in pairs(old.Owned or {}) do
   local tier,family=id:match("gear_(%d+)_(%d+)")
   if tier and map[tonumber(family)] then
    local w=P.AddWeapon(d,string.format("%s_%02d",map[tonumber(family)],tonumber(tier)),1)
    if w and old.Equipped==id then d.Equipped=w.Uid end
   end
  end
  d.StarterChosen=#d.Weapons&gt;0
  if d.Equipped=="" and d.Weapons[1] then d.Equipped=d.Weapons[1].Uid end
 end
 for key,value in pairs(P.New()) do if d[key]==nil then d[key]=value end end
 d.Level=math.clamp(math.floor(tonumber(d.Level) or 1),1,C.MaxLevel)
 if not P.CanTravel(d,d.Floor) then d.Floor=1 end
 if d.PendingForge then E.FinishForge(d,math.random()) end -- Recover a paid job after disconnect.
 return d
end
function Profiles.Load(player)
 local data
 if Profiles.Temporary then data=P.New() else
  for attempt=1,4 do
   local ok,result=pcall(function()
    return store:UpdateAsync("u_"..player.UserId,function(old)
     old=old or P.New()
     if old.Lock and old.Lock.Token~=token and os.time()-old.Lock.Time&lt;180 then return nil end
     old=migrate(old); old.Lock={Token=token,Time=os.time()}; return old
    end)
   end)
   if ok and result then data=result; break end
   task.wait(attempt)
  end
  if not data then player:Kick("Seu progresso está em uso ou indisponível. Aguarde e tente novamente."); return nil end
 end
 Profiles.Data[player]=migrate(data)
 return Profiles.Data[player]
end
function Profiles.Save(player,release)
 while Profiles.Saving[player] do task.wait(.1) end
 local d=Profiles.Data[player]; if not d then return false end
 if Profiles.Temporary then if release then Profiles.Data[player]=nil end; return true end
 Profiles.Saving[player]=true
 local snapshot=Http:JSONDecode(Http:JSONEncode(d)); local success=false
 for attempt=1,3 do
  local ok,result=pcall(function()
   return store:UpdateAsync("u_"..player.UserId,function(old)
    if not old or not old.Lock or old.Lock.Token~=token then return nil end
    snapshot.Lock=not release and {Token=token,Time=os.time()} or nil; return snapshot
   end)
  end)
  if ok and result then success=true; break end
  task.wait(attempt)
 end
 Profiles.Saving[player]=nil
 if release and success then Profiles.Data[player]=nil end
 if not success then warn("LittleRPG: falha de salvamento",player.UserId) end
 return success
end
function Profiles.Close(player)
 if Profiles.Closing[player] then return end
 Profiles.Closing[player]=true
 while Profiles.ReceiptBusy[player] do task.wait(.1) end
 Profiles.Save(player,true)
 Profiles.Data[player]=nil; Profiles.Travel[player]=nil; Profiles.Closing[player]=nil
end
Players.PlayerRemoving:Connect(Profiles.Close)
task.spawn(function()
 while task.wait(40) do
  for player in pairs(Profiles.Data) do
   if not Profiles.Travel[player] and not Profiles.Closing[player] then
    task.spawn(function() if not Profiles.Save(player,false) and player.Parent then player:Kick("Salvamento indisponível. Reconecte para proteger seu progresso.") end end)
   end
  end
 end
end)
game:BindToClose(function()
 for player in pairs(Profiles.Data) do task.spawn(Profiles.Close,player) end
 local deadline=os.clock()+25; while next(Profiles.Data) and os.clock()&lt;deadline do task.wait(.1) end
end)
return Profiles
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3873">
        <Properties>
          <string name="Name">WorldActions</string>
          <ProtectedString name="Source">-- Mineração escassa, NPCs de loja, poções e trabalho durável na ferraria.
local Shared=game.ReplicatedStorage.LittleRPG
local C=require(Shared.Config); local K=require(Shared.Catalog); local E=require(Shared.Economy); local P=require(Shared.Progression)
local W={}
function W.Start(ctx)
 local profiles=ctx.Profiles; local nodes={}
 function W.Near(player,kind)
  local d=profiles.Data[player]; local r=ctx.Runtime[player]; local root=ctx.Character(player)
  if not d or not r or r.Mode~="World" or not root then return false end
  local pos=C.Floors[d.Floor][kind]+C.Floors[d.Floor].Origin
  return (root.Position-pos).Magnitude&lt;=38
 end
 for _,marker in ipairs(workspace.LittleWorld.Interactions:GetChildren()) do
  local kind,floor=marker.Name:match("^(%a+)_(%d+)$"); floor=tonumber(floor)
  if kind=="Shop" or kind=="Forge" then
   ctx.Prompt(marker,kind=="Forge" and "Usar forja" or "Ver mercadorias",kind=="Forge" and "Casa do ferreiro" or "Mercador",function(player)
    local d=profiles.Data[player]
    if d and d.Floor==floor and W.Near(player,kind) then ctx.Feedback:FireClient(player,"Open",kind); ctx.Sync(player) end
   end)
  elseif kind=="Travel" then
   ctx.Prompt(marker,"Viajar entre andares","Elevador da cidade",function(player) ctx.Feedback:FireClient(player,"Open","Travel"); ctx.Sync(player) end)
  end
 end
 for _,node in ipairs(workspace.LittleWorld.OreNodes:GetChildren()) do
  local floor=tonumber(node.Name:match("^(%d)_")); local state={HP=4,Ready=true}; nodes[node]=state
  local prompt=ctx.Prompt(node,"Minerar","Veio de rocha",function(player)
   local d=profiles.Data[player]; local r=ctx.Runtime[player]
   if not d or not r or r.Mode~="World" or d.Floor~=floor or not state.Ready or not d.StarterChosen then return end
   if os.clock()&lt;(r.NextMine or 0) then return end; r.NextMine=os.clock()+1.15
   ctx.Animate(player,"Mine",1)
   ctx.Feedback:FireAllClients("Mine",node.Position)
   state.HP=state.HP-d.Pickaxe
   if state.HP&gt;0 then return end
   state.Ready=false; node.Transparency=.82; node.CanCollide=false
   local ore=E.RollOre(floor,math.random())
   if ore then d.Ores[ore]=(d.Ores[ore] or 0)+1; ctx.Notice(player,"+1 "..E.Ores[ore].Name) else ctx.Notice(player,"Apenas pedra. Procure outro veio.") end
   ctx.Sync(player)
   task.delay(100+floor*10,function() if node.Parent then state.HP=4; state.Ready=true; node.Transparency=0; node.CanCollide=true end end)
  end)
  prompt.HoldDuration=.7
 end
 function W.Action(player,verb,arg)
  local d=profiles.Data[player]; local r=ctx.Runtime[player]; if not d or not r then return end
  if verb=="Forge" then
   if type(arg)~="string" or not W.Near(player,"Forge") or d.PendingForge then return end
   local ok,message=E.BeginForge(d,arg); if not ok then ctx.Notice(player,message); return end
   -- All inputs debited once; PendingForge is recovered on next login if disconnected.
   r.Forging=true; local forgeRoot=ctx.Character(player); if forgeRoot then forgeRoot.Anchored=true end
   ctx.Animate(player,"Forge",10); ctx.Sync(player)
   ctx.Feedback:FireAllClients("Forge",player.UserId,d.Floor,arg)
   task.delay(10,function()
    if profiles.Data[player]==d and not profiles.Closing[player] and not profiles.Travel[player] then
     local result=E.FinishForge(d,math.random()); r.Forging=false
     if forgeRoot and forgeRoot.Parent then forgeRoot.Anchored=false end
     if result then ctx.Notice(player,"Forjado: "..K.Name(result)); ctx.Feedback:FireClient(player,"Forged",result) end
     ctx.Sync(player)
    end
   end)
  elseif verb=="Buy" then
   if type(arg)~="string" or not W.Near(player,"Shop") then return end
   local _,message=E.Buy(d,arg,d.Floor,math.floor(os.time()/C.StockSeconds)); ctx.Notice(player,message); ctx.Sync(player)
  elseif verb=="Supply" then
   local offer=type(arg)=="string" and C.Consumables[arg]
   if not offer or not W.Near(player,"Shop") or d.Gold&lt;offer.Price or d.Floor&lt;(offer.Floor or 1) then return end
   if arg=="health" or arg=="energy" then
    if d.Potions[arg]&gt;=99 then ctx.Notice(player,"Limite de 99 poções."); return end
    d.Potions[arg]=d.Potions[arg]+1
   else
    local tier=arg=="pickaxe2" and 2 or 3
    if d.Pickaxe&gt;=tier then ctx.Notice(player,"Sua picareta já é igual ou melhor."); return end
    d.Pickaxe=tier
   end
   d.Gold=d.Gold-offer.Price; ctx.Sync(player); ctx.Notice(player,offer.Name.." adquirido(a).")
  elseif verb=="Sell" then
   if type(arg)~="string" or not W.Near(player,"Shop") or arg==d.Equipped then return end
   for index,weapon in ipairs(d.Weapons) do
    if weapon.Uid==arg then
     d.Gold=d.Gold+math.floor(K.ById[weapon.Blueprint].Price*C.Rarities[weapon.Rarity].Multiplier*.2)
     table.remove(d.Weapons,index); ctx.Sync(player); ctx.Notice(player,"Arma vendida."); return
    end
   end
  elseif verb=="Potion" then
   if (arg~="health" and arg~="energy") or d.Potions[arg]&lt;1 or os.clock()&lt;(r.NextPotion or 0) then return end
   local _,hum=ctx.Character(player); if not hum then return end
   if arg=="health" and hum.Health&gt;=hum.MaxHealth or arg=="energy" and r.Energy&gt;=100 then return end
   d.Potions[arg]=d.Potions[arg]-1; r.NextPotion=os.clock()+3
   if arg=="health" then hum.Health=math.min(hum.MaxHealth,hum.Health+C.Consumables.health.Amount+hum.MaxHealth*.2)
   else r.Energy=math.min(100,r.Energy+50) end
   ctx.Animate(player,"Drink",.7); ctx.Sync(player)
  end
 end
end
return W
</ProtectedString>
        </Properties>
