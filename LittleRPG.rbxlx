  <Item class="ReplicatedStorage" referent="RBX3857">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBX3858">
      <Properties>
        <string name="Name">LittleRPG</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX3859">
        <Properties>
          <string name="Name">Catalog</string>
          <ProtectedString name="Source">-- Seis famílias físicas. Dez modelos por família; raridade é separada do modelo.
local C=require(script.Parent.Config)
local K={List={},ById={},Families={
 {Id="dagger",Name="Adaga",Shape="Dagger",Cooldown=.5,Range=9,Damage=10,Special="Corte duplo",Style="DualCut"},
 {Id="longsword",Name="Espada de uma mão",Shape="Sword",Cooldown=.8,Range=12,Damage=10,Special="Corte ascendente",Style="Uppercut"},
 {Id="rapier",Name="Rapieira",Shape="Rapier",Cooldown=.65,Range=15,Damage=10,Special="Estocada precisa",Style="Thrust"},
 {Id="light_hammer",Name="Martelo leve",Shape="LightHammer",Cooldown=.9,Range=10,Damage=13,Special="Quebra-guarda",Style="Bash"},
 {Id="heavy_hammer",Name="Martelo pesado",Shape="HeavyHammer",Cooldown=1.4,Range=12,Damage=21,Special="Impacto sísmico",Style="Slam"},
 {Id="greatsword",Name="Espada de duas mãos",Shape="Greatsword",Cooldown=1.2,Range=16,Damage=18,Special="Arco do executor",Style="Cleave"},
}}
K.Tiers={
 {Name="do Aprendiz",Level=1,Ore="iron"}, {Name="de Aço",Level=5,Ore="iron"},
 {Name="do Guardião",Level=10,Ore="copper"},{Name="do Crepúsculo",Level=15,Ore="silver"},
 {Name="de Ardósia",Level=22,Ore="silver"},{Name="do Horizonte",Level=30,Ore="cobalt"},
 {Name="da Forja",Level=40,Ore="cobalt"},{Name="de Obsidiana",Level=55,Ore="obsidian"},
 {Name="do Eclipse",Level=75,Ore="obsidian"},{Name="do Abismo",Level=100,Ore="obsidian"},
}
for _,family in ipairs(K.Families) do
 for tier,t in ipairs(K.Tiers) do
  local id=string.format("%s_%02d",family.Id,tier)
  local item={Id=id,Name=family.Name.." "..t.Name,Family=family.Id,Shape=family.Shape,Tier=tier,Level=t.Level,
   Damage=math.floor(family.Damage*(1+(tier-1)*.7)),Cooldown=family.Cooldown,Range=family.Range,Special=family.Special,Style=family.Style,
   Energy=20+tier,SpecialCooldown=8+family.Cooldown*2,Ore=t.Ore,OreCost=3+tier*2,GoldCost=15*tier*tier,Price=50*tier*tier}
  if family.Id=="greatsword" and tier==10 then item.Name="Noctífera · Lâmina dos Dois Horizontes" end
  K.ById[id]=item; table.insert(K.List,item)
 end
end
function K.Damage(weapon,level,strength,special)
 local item=K.ById[weapon.Blueprint]
 local rank=C.Rarities[weapon.Rarity or 1]
 local bonus=1+.45*(strength or 0)/((strength or 0)+60)
 local result=item.Damage*rank.Multiplier*bonus*(1+math.min(14999,level-1)*.007)
 return math.floor(result*(special and (3.4+(item.Tier-1)*.06) or 1)+.5)
end
function K.Name(weapon) return K.ById[weapon.Blueprint].Name.." · "..C.Rarities[weapon.Rarity].Name end
return K
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3860">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- CONFIGURAÇÃO CENTRAL. Edite aqui os limites, cidades e IDs de sua experiência.
local C = {}
C.Version = 2
C.MaxLevel = 15000
C.MaxFloors = 3 -- Apenas três andares publicados; minérios já têm planejamento até 100.
C.MaxInventory = 240
C.StockSeconds = 1800
C.FloorHeight = 800
C.MapHalfSize = Vector3.new(800,0,600)
C.DungeonX = 6000
C.MazeSize = 15
C.MazeCell = 26
C.Floors = {
 {Name="01 · VALE DOS PIONEIROS",MinLevel=1,Origin=Vector3.new(0,0,0),Spawn=Vector3.new(-475,6,125),Town={X=-405,Z=0,W=790,D=1200},Forge=Vector3.new(-500,0,-135),Shop=Vector3.new(-500,0,20),Boss="alpha"},
 {Name="02 · CIDADE DE ARDÓSIA",MinLevel=10,Origin=Vector3.new(0,800,0),Spawn=Vector3.new(0,6,180),Town={X=0,Z=0,W=924,D=693},Forge=Vector3.new(-180,0,90),Shop=Vector3.new(180,0,90),Boss="warden"},
 {Name="03 · BASTIÃO OBSIDIANA",MinLevel=25,Origin=Vector3.new(0,1600,0),Spawn=Vector3.new(0,6,180),Town={X=0,Z=0,W=924,D=693},Forge=Vector3.new(-180,0,90),Shop=Vector3.new(180,0,90),Boss="sovereign"},
}
C.StarterFamilies = {"dagger","longsword","rapier"}
C.Rarities = {
 {Name="Comum",Color={185,190,205},Multiplier=1},
 {Name="Incomum",Color={80,250,123},Multiplier=1.12},
 {Name="Rara",Color={139,233,253},Multiplier=1.3},
 {Name="Épica",Color={189,147,249},Multiplier=1.6},
 {Name="Mítica",Color={255,121,198},Multiplier=2},
 {Name="Lendária",Color={255,184,108},Multiplier=2.5},
 {Name="Ultra lendária",Color={255,85,85},Multiplier=3.2},
}
C.Enemies = {
 wolf={Name="Lobo cinzento",Floor=1,Level=1,HP=100,Damage=7,XP=2,Gold=3,Speed=13,Shape="Wolf",Color={133,145,156}},
 boar={Name="Javali selvagem",Floor=1,Level=1,HP=100,Damage=9,XP=2,Gold=4,Speed=10,Shape="Boar",Color={133,99,73}},
 alpha={Name="ALFA DA PEDRA",Floor=1,Level=8,HP=900,Damage=18,XP=70,Gold=140,Speed=12,Shape="Wolf",Boss=true,Color={159,168,178}},
 bandit={Name="Saqueador das ruínas",Floor=2,Level=12,HP=220,Damage=15,XP=28,Gold=18,Speed=13,Shape="Knight",Color={103,114,136}},
 beetle={Name="Besouro de ardósia",Floor=2,Level=18,HP=300,Damage=19,XP=44,Gold=24,Speed=10,Shape="Beetle",Color={113,128,149}},
 warden={Name="CARCEREIRO DE ARDÓSIA",Floor=2,Level=22,HP=2400,Damage=32,XP=420,Gold=450,Speed=9,Shape="Knight",Boss=true,Color={155,143,184}},
 construct={Name="Autômato de obsidiana",Floor=3,Level=32,HP=530,Damage=29,XP=110,Gold=44,Speed=11,Shape="Construct",Color={83,80,97}},
 sovereign={Name="SOBERANO DA FORJA",Floor=3,Level=45,HP=5200,Damage=44,XP=1300,Gold=1100,Speed=10,Shape="Construct",Boss=true,Color={255,184,108}},
}
C.DropChance = {Normal=.02,Boss=.15}
-- Probabilidades condicionais após cair uma arma. A ultra só sai do chefe 3.
C.DropWeights = {6000,2600,1000,320,70,9,1}
C.Consumables = {
 health={Name="Poção de cura",Price=15,Amount=45},
 energy={Name="Poção de energia",Price=12,Amount=50},
 pickaxe2={Name="Picareta de aço",Price=220,Floor=2},
 pickaxe3={Name="Picareta reforçada",Price=750,Floor=3},
}
-- Compras DIRETAS, sem sorteio. ID 0 mantém a oferta desativada.
C.Products = {
 {Key="legendary_rapier",ProductId=0,Name="Rapieira do Horizonte · Lendária",Blueprint="rapier_06",Rarity=6},
 {Key="epic_longsword",ProductId=0,Name="Espada do Crepúsculo · Épica",Blueprint="longsword_04",Rarity=4},
}
C.Audio = {Menu="",Hit="",LevelUp="",Ambient="",Machine=""}
return C
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3861">
        <Properties>
          <string name="Name">Economy</string>
          <ProtectedString name="Source">-- Regras puras de mineração, estoque e ferraria: servidor é a autoridade.
local C=require(script.Parent.Config)
local K=require(script.Parent.Catalog)
local P=require(script.Parent.Progression)
local E={OreList={
 {Id="iron",Name="Ferro",MinFloor=1,Color={155,151,146}},
 {Id="copper",Name="Cobre",MinFloor=1,Color={198,129,80}},
 {Id="coal",Name="Carvão",MinFloor=1,Color={63,60,67}},
 {Id="silver",Name="Prata",MinFloor=2,Color={191,205,220}},
 {Id="cobalt",Name="Cobalto",MinFloor=3,Color={95,123,199}},
 {Id="obsidian",Name="Obsidiana",MinFloor=3,Color={117,83,150}},
 {Id="nickel",Name="Níquel",MinFloor=10,Color={164,171,142}},
 {Id="titanium",Name="Titânio",MinFloor=20,Color={173,173,199}},
 {Id="tungsten",Name="Tungstênio",MinFloor=35,Color={130,146,161}},
 {Id="chromium",Name="Cromo",MinFloor=50,Color={154,199,186}},
 {Id="iridium",Name="Irídio",MinFloor=65,Color={211,167,212}},
 {Id="osmium",Name="Ósmio",MinFloor=80,Color={142,187,210}},
 {Id="aethersteel",Name="Aço do último horizonte",MinFloor=95,Color={255,222,160}},
},Ores={}}
for _,ore in ipairs(E.OreList) do E.Ores[ore.Id]=ore end
function E.OreChances(floor)
 local pool={iron=.18/(1+.055*(floor-1)),copper=.10/(1+.035*(floor-1)),coal=.24}
 if floor&gt;=2 then pool.silver=.065 end
 if floor&gt;=3 then pool.cobalt=.045; pool.obsidian=.018 end
 for _,ore in ipairs(E.OreList) do if ore.MinFloor&gt;=10 and floor&gt;=ore.MinFloor then pool[ore.Id]=.025/(1+(floor-ore.MinFloor)*.025) end end
 return pool -- Remaining probability is ordinary stone; never reward a paid random roll.
end
function E.RollOre(floor,roll)
 local acc=0; local chances=E.OreChances(floor)
 for _,ore in ipairs(E.OreList) do acc=acc+(chances[ore.Id] or 0); if roll&lt;acc then return ore.Id end end
 return nil
end
function E.ForgeOdds(skill)
 local s=math.max(0,math.min(100,skill))/100
 return {(.78-.28*s),(.18+.1*s),(.035+.10*s),(.004+.065*s),(.001+.015*s)}
end
function E.Roll(weights,roll)
 local total=0; for _,w in ipairs(weights) do total=total+w end
 local target=roll*total; local acc=0
 for i,w in ipairs(weights) do acc=acc+w; if target&lt;acc then return i end end
 return #weights
end
function E.CanForge(d,id)
 local item=K.ById[id]
 if not item then return false,"Molde inválido." end
 if #d.Weapons&gt;=C.MaxInventory then return false,"Mochila cheia. Venda uma arma." end
 if d.Level&lt;item.Level then return false,"Requer nível "..item.Level end
 if d.Gold&lt;item.GoldCost or (d.Ores[item.Ore] or 0)&lt;item.OreCost or (d.Ores.coal or 0)&lt;2 then return false,"Faltam minérios, carvão ou moedas." end
 return true
end
function E.BeginForge(d,id)
 if d.PendingForge then return false,"Você já tem uma forja em andamento." end
 local ok,message=E.CanForge(d,id); if not ok then return false,message end
 local item=K.ById[id]
 d.Ores[item.Ore]=d.Ores[item.Ore]-item.OreCost; d.Ores.coal=d.Ores.coal-2; d.Gold=d.Gold-item.GoldCost
 d.PendingForge={Blueprint=id}; return true
end
function E.FinishForge(d,roll)
 local job=d.PendingForge; if not job then return nil end
 local rarity=E.Roll(E.ForgeOdds(P.ForgeSkill(d)),roll)
 local weapon=P.AddWeapon(d,job.Blueprint,rarity,true)
 if weapon then d.PendingForge=nil; d.ForgeXP=d.ForgeXP+5 end
 return weapon
end
function E.Stock(floor,epoch)
 local list={}; local maxRarity=floor==3 and 5 or floor==2 and 4 or 3
 for index,item in ipairs(K.List) do
  local starter=item.Tier==1 and (item.Family=="dagger" or item.Family=="longsword" or item.Family=="rapier")
  local permitted=item.Tier&lt;=floor*3 and (starter or item.Tier&gt;1)
  local seed=(epoch*7919+index*104729+floor*137)%1000
  local rarity=starter and 1 or math.min(maxRarity,1+math.floor(((epoch*3571+index*4271+floor*79)%1000)/190))
  local available=permitted and (starter or seed&lt;200+floor*70)
  list[#list+1]={Key=item.Id,Blueprint=item.Id,Rarity=rarity,Count=available and (starter and 5 or rarity==5 and 1 or 2) or 0,Price=math.floor(item.Price*C.Rarities[rarity].Multiplier*1.5)}
 end
 return list
end
function E.Buy(d,key,floor,epoch)
 if #d.Weapons&gt;=C.MaxInventory then return false,"Mochila cheia." end
 if d.StockEpoch~=epoch then d.StockEpoch=epoch; d.StockBought={} end
 for _,offer in ipairs(E.Stock(floor,epoch)) do
  if offer.Key==key then
   local bought=d.StockBought[floor..":"..key] or 0
   if offer.Count&lt;=bought then return false,"Fora de estoque." end
   if d.Level&lt;K.ById[key].Level then return false,"Seu nível é insuficiente." end
   if d.Gold&lt;offer.Price then return false,"Moedas insuficientes." end
   local weapon=P.AddWeapon(d,key,offer.Rarity)
   if not weapon then return false,"A última vaga está reservada para sua forja." end
   d.Gold=d.Gold-offer.Price; d.StockBought[floor..":"..key]=bought+1
   return true,"Arma comprada."
  end
 end
 return false,"Oferta inválida."
end
return E
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3862">
        <Properties>
          <string name="Name">Maze</string>
          <ProtectedString name="Source">-- DFS determinístico: cada célula é alcançável, com salas mortas e rotas longas.
-- Sem Random do Roblox: o mesmo algoritmo pode ser testado fora do Studio.
local M={}
function M.Generate(size,seed)
 local cells={}; for z=1,size do cells[z]={}; for x=1,size do cells[z][x]={N=true,E=true,S=true,W=true} end end
 local function random(n) seed=(seed*48271)%2147483647; return seed%n+1 end
 local directions={{0,-1,"N","S"},{1,0,"E","W"},{0,1,"S","N"},{-1,0,"W","E"}}
 local visited={['1,1']=true}; local stack={{1,1}}; local distances={['1,1']=0}; local farthest={1,1}; local longest=0
 while #stack&gt;0 do
  local current=stack[#stack]; local x,z=current[1],current[2]; local choices={}
  for _,dir in ipairs(directions) do local nx,nz=x+dir[1],z+dir[2]; if nx&gt;=1 and nx&lt;=size and nz&gt;=1 and nz&lt;=size and not visited[nx..","..nz] then choices[#choices+1]=dir end end
  if #choices==0 then table.remove(stack) else
   local dir=choices[random(#choices)]; local nx,nz=x+dir[1],z+dir[2]
   cells[z][x][dir[3]]=false; cells[nz][nx][dir[4]]=false; visited[nx..","..nz]=true
   local distance=distances[x..","..z]+1; distances[nx..","..nz]=distance
   if distance&gt;longest then longest=distance; farthest={nx,nz} end
   stack[#stack+1]={nx,nz}
  end
 end
 return {Cells=cells,Goal=farthest,Length=longest,Size=size}
end
return M
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3863">
        <Properties>
          <string name="Name">Progression</string>
          <ProtectedString name="Source">local C=require(script.Parent.Config)
local P={}
function P.Required(level) return math.floor(4*level^1.35*(1+(level-1)/250)) end
function P.New()
 return {Version=2,Level=1,XP=0,Gold=25,Floor=1,Unlocked=1,StarterChosen=false,Weapons={},NextWeapon=1,Equipped="",Bosses={},Kills=0,
  Points=0,Stats={Forca=0,Defesa=0,Movimento=0,Ferraria=0},ForgeXP=0,Ores={},Potions={health=2,energy=2},Pickaxe=1,Receipts={},StockBought={}}
end
function P.MaxHP(d) return 100+(d.Level-1)*3+(d.Stats.Defesa or 0)*2 end
function P.Speed(d) local n=d.Stats.Movimento; return 18+12*n/(n+15) end
function P.Dash(d) local n=d.Stats.Movimento; return 16+24*n/(n+30) end
function P.Reduction(d) local n=d.Stats.Defesa; return .65*n/(n+80) end
function P.ForgeSkill(d) return math.min(100,d.Stats.Ferraria*.4+math.sqrt(d.ForgeXP)*2) end
function P.Grant(d,xp,gold)
 d.Gold=d.Gold+gold; d.XP=d.XP+xp; local before=d.Level
 while d.Level&lt;C.MaxLevel and d.XP&gt;=P.Required(d.Level) do d.XP=d.XP-P.Required(d.Level); d.Level=d.Level+1; d.Points=d.Points+1 end
 if d.Level==C.MaxLevel then d.XP=0 end
 return d.Level-before
end
function P.Allocate(d,key)
 if d.Points&lt;1 or d.Stats[key]==nil then return false end
 d.Points=d.Points-1; d.Stats[key]=d.Stats[key]+1; return true
end
function P.CanTravel(d,floor)
 return type(floor)=="number" and floor==math.floor(floor) and C.Floors[floor]~=nil and floor&lt;=d.Unlocked
end
function P.InTown(pos,floor)
 local f=C.Floors[floor]; if not f then return false end
 local t=f.Town
 return math.abs(pos.Y-f.Origin.Y)&lt;80 and math.abs(pos.X-t.X)&lt;=t.W/2 and math.abs(pos.Z-t.Z)&lt;=t.D/2
end
function P.AddWeapon(d,blueprint,rarity,completingForge)
 local reserved=d.PendingForge and not completingForge and 1 or 0
 if #d.Weapons&gt;=C.MaxInventory-reserved then return nil end
 local uid=tostring(d.NextWeapon); d.NextWeapon=d.NextWeapon+1
 local weapon={Uid=uid,Blueprint=blueprint,Rarity=rarity}; table.insert(d.Weapons,weapon); return weapon
end
function P.Weapon(d,uid) for _,w in ipairs(d.Weapons) do if w.Uid==uid then return w end end end
function P.Choose(d,family)
 if d.StarterChosen then return false end
 local valid=false; for _,v in ipairs(C.StarterFamilies) do if family==v then valid=true end end
 if not valid then return false end
 local w=P.AddWeapon(d,family.."_01",1); if not w then return false end
 d.Equipped=w.Uid; d.StarterChosen=true; return true
end
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3864">
        <Properties>
          <string name="Name">WeaponVisual</string>
          <ProtectedString name="Source">-- Modelagem procedural original, compartilhada pela mão do jogador e pelos previews 3D.
local K=require(script.Parent.Catalog)
local C=require(script.Parent.Config)
local V={}
function V.Build(weapon,asTool)
 local item=K.ById[weapon.Blueprint]; local rarity=C.Rarities[weapon.Rarity]
 local container=Instance.new(asTool and "Tool" or "Model"); container.Name=K.Name(weapon)
 if asTool then container.CanBeDropped=false; container:SetAttribute("LittleGear",true); container:SetAttribute("WeaponUid",weapon.Uid); container.Grip=CFrame.Angles(math.rad(90),0,0) end
 local tint=Color3.fromRGB(unpack(rarity.Color)); local steel=Color3.fromRGB(152,164,181)
 if item.Tier&gt;=8 then steel=Color3.fromRGB(39,40,55) end
 local handle
 local function piece(name,size,cf,color,cls)
  local p=Instance.new(cls or "Part"); p.Name=name; p.Size=size; p.Color=color; p.Material=Enum.Material.Metal; p.CanCollide=false; p.CanTouch=false; p.Massless=true; p.Anchored=not asTool; p.CFrame=cf; p.Parent=container
  if name=="Handle" then handle=p elseif asTool then local w=Instance.new("WeldConstraint"); w.Part0=handle; w.Part1=p; w.Parent=p end
  return p
 end
 local two=item.Shape=="Greatsword" or item.Shape=="HeavyHammer"
 piece("Handle",Vector3.new(.27,two and 2 or 1.25,.27),CFrame.new(),Color3.fromRGB(53,42,49))
 for i=1,5 do piece("LeatherWrap",Vector3.new(.3,.07,.3),CFrame.new(0,-.55+i*.18,0),Color3.fromRGB(94,71,78)) end
 piece("Pommel",Vector3.new(.42,.35,.42),CFrame.new(0,two and -1.1 or -.8,0),tint)
 if item.Shape=="LightHammer" or item.Shape=="HeavyHammer" then
  local scale=two and 1.5 or 1
  piece("Shaft",Vector3.new(.3,2.5,.3),CFrame.new(0,1.4,0),steel)
  piece("HammerHead",Vector3.new(2.2,1.4,1.2)*scale,CFrame.new(0,3,0),steel)
  for _,side in ipairs({-1,1}) do piece("StrikingFace",Vector3.new(.2,1.5,1.3)*scale,CFrame.new(side*1.15*scale,3,0),tint) end
 else
  local length=item.Shape=="Dagger" and 1.8 or item.Shape=="Rapier" and 4.7 or two and 6.5 or 3.9
  local width=item.Shape=="Rapier" and .16 or two and .9 or .5
  piece("Blade",Vector3.new(width,length,.15),CFrame.new(0,1+length/2,0),steel)
  piece("Edge",Vector3.new(.06,length,.17),CFrame.new(width/2,1+length/2,0),Color3.fromRGB(211,219,226))
  piece("Point",Vector3.new(width,.7,.15),CFrame.new(0,1+length+.35,0)*CFrame.Angles(0,math.pi/2,0),steel,"WedgePart")
  piece("Crossguard",Vector3.new(two and 2.4 or 1.3,.2,.35),CFrame.new(0,.8,0),tint)
  if item.Shape=="Rapier" then
   for i=0,7 do local a=i*math.pi/4; piece("BasketGuard",Vector3.new(.12,.38,.12),CFrame.new(math.cos(a)*.45,.65,math.sin(a)*.45)*CFrame.Angles(0,0,a),tint) end
  end
  if two then
   for _,side in ipairs({-1,1}) do piece("SweptGuard",Vector3.new(.25,1.3,.3),CFrame.new(side*1.1,1.25,0)*CFrame.Angles(0,0,side*-.45),tint) end
   if item.Tier==10 then
    piece("Fuller",Vector3.new(.12,length-.8,.19),CFrame.new(0,1.5+length/2,0),tint)
    for i=1,4 do piece("EngravedPlate",Vector3.new(.6,.13,.2),CFrame.new(0,2+i*.9,0)*CFrame.Angles(0,0,.5),Color3.fromRGB(106,104,124)) end
   end
  end
 end
 if not asTool then container.PrimaryPart=handle end
 return container
end
return V
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX3865">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX3866">
      <Properties>
        <string name="Name">LittleRPGServer</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX3867">
        <Properties>
          <string name="Name">Dungeons</string>
          <ProtectedString name="Source">-- Instância solo por servidor reservado. No Studio, mesma dungeon em modo local.
local Teleport=game:GetService("TeleportService")
local Http=game:GetService("HttpService")
local Run=game:GetService("RunService")
local C=require(game.ReplicatedStorage.LittleRPG.Config)
local D={}
function D.Start(ctx)
 local profiles=ctx.Profiles; local restoring={}
 local function restore(player,message)
  if not profiles.Travel[player] or not player.Parent or restoring[player] then return end
  restoring[player]=true
  -- Loading is necessary only after the old session was durably released.
  if not profiles.Data[player] then profiles.Load(player) end
  profiles.Travel[player]=nil; restoring[player]=nil
  local root,hum=ctx.Character(player); if root then root.Anchored=false end
  if hum then hum.WalkSpeed=ctx.Speed(player) end
  ctx.Notice(player,message); ctx.Sync(player)
 end
 local function transfer(player,toDungeon)
  local d=profiles.Data[player]; local r=ctx.Runtime[player]
  if not d or not r or profiles.Travel[player] or profiles.ReceiptBusy[player] or d.PendingForge then return end
  if Run:IsStudio() then
   r.Mode=toDungeon and "Dungeon" or "World"; r.InCombatUntil=0
   ctx.RespawnAt(player); ctx.Sync(player)
   ctx.Notice(player,toDungeon and "Dungeon local de teste — em produção: servidor reservado." or "Você voltou à cidade.")
   return
  end
  profiles.Travel[player]=true
  local root=ctx.Character(player); if root then root.Anchored=true end
  local options=Instance.new("TeleportOptions")
  if toDungeon then
   local serverId=Http:GenerateGUID(false); local ticket=Http:GenerateGUID(false)
   d.DungeonTicket={Token=ticket,Server=serverId,Floor=d.Floor,Expires=os.time()+600}
   options.ReservedServerId=serverId
   options:SetTeleportData({DungeonToken=ticket})
  else d.DungeonTicket=nil end
  if not profiles.Save(player,true) then restore(player,"Não foi possível salvar antes da viagem. Tente novamente."); return end
  local ok,err=pcall(function() Teleport:TeleportAsync(game.PlaceId,{player},options) end)
  if not ok then warn("Dungeon teleport",err); restore(player,"O teleporte falhou. Seu progresso foi preservado; tente novamente.") end
 end
 function D.Arrive(player,d)
  local r=ctx.Runtime[player]; r.Mode="World"
  if game.PrivateServerId~="" and game.PrivateServerOwnerId==0 then
   local join=player:GetJoinData(); local data=join.TeleportData; local ticket=d.DungeonTicket
   if ticket and data and ticket.Token==data.DungeonToken and ticket.Server==game.PrivateServerId and ticket.Expires&gt;=os.time() and ticket.Floor&lt;=d.Unlocked then
    d.Floor=ticket.Floor; r.Mode="Dungeon"
   else player:Kick("Esta dungeon não tem uma entrada válida. Entre pela página principal do jogo."); return false end
  end
  return true
 end
 function D.Enter(player) transfer(player,true) end
 function D.Exit(player) transfer(player,false) end
 Teleport.TeleportInitFailed:Connect(function(player) restore(player,"A conexão com a dungeon falhou. Tente entrar novamente.") end)
 local folder=workspace.LittleWorld.Interactions
 for _,marker in ipairs(folder:GetChildren()) do
  if marker.Name:match("^DungeonEntry_") then
   local floor=tonumber(marker.Name:match("_(%d+)$"))
   ctx.Prompt(marker,"Entrar na dungeon","Pilar central",function(player)
    local d=profiles.Data[player]; local r=ctx.Runtime[player]
    if d and r and r.Mode=="World" and d.Floor==floor and d.StarterChosen then D.Enter(player) end
   end)
  elseif marker.Name:match("^DungeonExit_") then
   ctx.Prompt(marker,"Voltar à cidade","Saída da dungeon",function(player)
    if ctx.Runtime[player] and ctx.Runtime[player].Mode=="Dungeon" then D.Exit(player) end
   end)
  end
 end
end
return D
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3868">
        <Properties>
          <string name="Name">Enemies</string>
          <ProtectedString name="Source">-- Criaturas físicas, telegraph de golpes e navegação com orçamento limitado.
local Run=game:GetService("RunService")
local Paths=game:GetService("PathfindingService")
local C=require(game.ReplicatedStorage.LittleRPG.Config)
local P=require(game.ReplicatedStorage.LittleRPG.Progression)
local Enemies={Active={}}
function Enemies.Start(ctx)
 local folder=Instance.new("Folder"); folder.Name="LittleEnemies"; folder.Parent=workspace
 local function spawn(id,home,mode)
  local def=C.Enemies[id]; local s=def.Boss and 1.8 or 1
  local model=Instance.new("Model"); model.Name=def.Name
  model:SetAttribute("EnemyId",id); model:SetAttribute("Floor",def.Floor); model:SetAttribute("Mode",mode)
  local limbs={}; local root
  local function part(name,size,offset,color)
   local p=Instance.new("Part"); p.Name=name; p.Size=size*s; p.CFrame=CFrame.new(home+offset*s); p.Color=color or Color3.fromRGB(unpack(def.Color)); p.Material=Enum.Material.Slate; p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.Parent=model
   if name=="HumanoidRootPart" then root=p; p.Transparency=1; model.PrimaryPart=p end
   if name=="Leg" then limbs[#limbs+1]={Part=p,Offset=CFrame.new(offset*s)} end
   return p
  end
  part("HumanoidRootPart",Vector3.new(2,2,2),Vector3.new())
  if def.Shape=="Wolf" or def.Shape=="Boar" or def.Shape=="Beetle" then
   part("Body",Vector3.new(2.6,2,4.4),Vector3.new(0,.4,0))
   part("Head",Vector3.new(1.8,1.6,1.7),Vector3.new(0,1,-2.5))
   part("Muzzle",Vector3.new(1.2,.7,1.2),Vector3.new(0,.6,-3.5),Color3.fromRGB(65,66,76))
   for _,side in ipairs({-1,1}) do
    part("Ear",Vector3.new(.45,1,.65),Vector3.new(side*.7,2,-2.3))
    part("Eye",Vector3.new(.2,.2,.15),Vector3.new(side*.6,1.2,-3.4),Color3.fromRGB(255,220,132))
    for _,z in ipairs({-1.3,1.3}) do part("Leg",Vector3.new(.55,2,.65),Vector3.new(side*.95,-1,z)) end
    if def.Shape=="Boar" then part("Tusk",Vector3.new(.25,.8,.25),Vector3.new(side*.8,.5,-3.6),Color3.fromRGB(242,228,200)) end
   end
   part("Tail",Vector3.new(.5,.5,2),Vector3.new(0,.7,3))
   if def.Shape=="Beetle" then part("Carapace",Vector3.new(3.5,1.3,4.5),Vector3.new(0,1.5,0),Color3.fromRGB(72,86,112)) end
  else
   part("Torso",Vector3.new(2.6,2.8,1.7),Vector3.new(0,.5,0))
   part("Head",Vector3.new(1.6,1.4,1.4),Vector3.new(0,2.6,0))
   for _,side in ipairs({-1,1}) do
    part("Arm",Vector3.new(.9,2.7,1),Vector3.new(side*1.8,.3,0))
    part("Leg",Vector3.new(1,2,1),Vector3.new(side*.7,-1.8,0))
    part("Shoulder",Vector3.new(1.4,.7,1.6),Vector3.new(side*1.7,1.8,0),Color3.fromRGB(58,58,72))
   end
   part("Weapon",Vector3.new(.6,4,.4),Vector3.new(2,1.4,-.7),Color3.fromRGB(195,190,190))
   if def.Shape=="Construct" then local core=part("Furnace",Vector3.new(.8,.9,.2),Vector3.new(0,.7,-.96),Color3.fromRGB(255,184,108)); core.Material=Enum.Material.Neon end
  end
  if def.Boss then for i=-1,1 do part("Crown",Vector3.new(.4,1.2,.4),Vector3.new(i*.6,3.7,0),Color3.fromRGB(211,176,106)) end end
  local hum=Instance.new("Humanoid"); hum.RequiresNeck=false; hum.BreakJointsOnDeath=false; hum.MaxHealth=def.HP; hum.Health=def.HP; hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; hum.Parent=model
  local gui=Instance.new("BillboardGui"); gui.Size=UDim2.fromOffset(def.Boss and 270 or 180,44); gui.StudsOffset=Vector3.new(0,5*s,0); gui.MaxDistance=100; gui.Parent=root
  local label=Instance.new("TextLabel"); label.Size=UDim2.fromScale(1,.65); label.BackgroundTransparency=1; label.Text=def.Name.." · Nv. "..def.Level; label.TextColor3=Color3.fromRGB(248,248,242); label.TextStrokeTransparency=.3; label.Font=Enum.Font.GothamMedium; label.TextSize=12; label.Parent=gui
  local bar=Instance.new("Frame"); bar.Size=UDim2.fromScale(1,.12); bar.Position=UDim2.fromScale(0,.8); bar.BackgroundColor3=Color3.fromRGB(255,85,85); bar.BorderSizePixel=0; bar.Parent=gui
  model.Parent=folder
  Enemies.Active[model]={Def=def,Id=id,Mode=mode,Home=home,Hum=hum,Bar=bar,Limbs=limbs,NextAttack=0,NextPath=0,Damage={},HomeY=home.Y}
 end
 for _,marker in ipairs(workspace.LittleWorld.Spawns:GetChildren()) do
  local id,mode=marker.Name:match("^(%a+)_(%a+)_")
  if id and C.Enemies[id] then spawn(id,marker.Position,mode) end
 end
 function Enemies.Hit(player,model,damage)
  local e=Enemies.Active[model]; if not e or e.Hum.Health&lt;=0 then return end
  local actual=math.min(damage,e.Hum.Health); e.Damage[player]=(e.Damage[player] or 0)+actual
  e.Hum.Health=math.max(0,e.Hum.Health-actual); e.Bar.Size=UDim2.fromScale(e.Hum.Health/e.Def.HP,.12)
  ctx.Feedback:FireAllClients("Hit",model.PrimaryPart.Position,actual)
  if e.Hum.Health&lt;=0 then
   Enemies.Active[model]=nil
   for player,dealt in pairs(e.Damage) do
    local d=ctx.Profiles.Data[player]; local r=ctx.Runtime[player]; local root=ctx.Character(player)
    if d and r and root and not ctx.Profiles.Travel[player] and d.Floor==e.Def.Floor and r.Mode==e.Mode and dealt&gt;=e.Def.HP*.05 and (root.Position-model.PrimaryPart.Position).Magnitude&lt;140 then ctx.OnKill(player,e.Id) end
   end
   ctx.Feedback:FireAllClients("Defeat",model.PrimaryPart.Position); model:Destroy()
   task.delay(e.Def.Boss and 60 or 25,function() spawn(e.Id,e.Home,e.Mode) end)
  end
 end
 local elapsed=0
 Run.Heartbeat:Connect(function(dt)
  elapsed=elapsed+dt; if elapsed&lt;.1 then return end
  local step=math.min(.2,elapsed); elapsed=0
  for model,e in pairs(Enemies.Active) do
   local root=model.PrimaryPart; local target; local best=e.Def.Boss and 100 or 65
   for player,d in pairs(ctx.Profiles.Data) do
    local r=ctx.Runtime[player]; local hrp,hum=ctx.Character(player)
    if r and hrp and hum and not ctx.Profiles.Travel[player] and d.Floor==e.Def.Floor and r.Mode==e.Mode and (r.Mode=="Dungeon" or not P.InTown(hrp.Position,d.Floor)) then
     local dist=(hrp.Position-root.Position).Magnitude
     if dist&lt;best then best=dist; target=hrp end
    end
   end
   if (root.Position-e.Home).Magnitude&gt;150 then target=nil end
   local destination=target and Vector3.new(target.Position.X,e.HomeY,target.Position.Z) or e.Home
   if not target and e.Targeted then e.Hum.Health=e.Def.HP; e.Bar.Size=UDim2.fromScale(1,.12); e.Damage={} end
   e.Targeted=target~=nil
   local delta=destination-root.Position
   local moving=delta.Magnitude&gt;6 and not e.Windup
   if moving then
    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={folder,target and target.Parent or folder}
    local obstruction=workspace:Raycast(root.Position,delta.Unit*math.min(8,delta.Magnitude),params)
    if obstruction and os.clock()&gt;e.NextPath and not e.PathBusy then
     e.NextPath=os.clock()+2.5; e.PathBusy=true
     task.spawn(function()
      local path=Paths:CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=false,WaypointSpacing=5})
      local ok=pcall(function() path:ComputeAsync(root.Position,destination) end)
      if ok and path.Status==Enum.PathStatus.Success then e.Waypoints=path:GetWaypoints(); e.Waypoint=2 end
      e.PathBusy=false
     end)
    end
    local goal=destination
    if e.Waypoints and e.Waypoints[e.Waypoint] then
     local waypoint=e.Waypoints[e.Waypoint].Position; goal=Vector3.new(waypoint.X,e.HomeY,waypoint.Z)
     if (goal-root.Position).Magnitude&lt;4 then e.Waypoint=e.Waypoint+1 end
    end
    local direction=goal-root.Position
    if direction.Magnitude&gt;.1 then
     local travel=direction.Unit*math.min(direction.Magnitude,e.Def.Speed*step)
     local hit=workspace:Raycast(root.Position,travel+direction.Unit*2,params)
     if not hit then local pos=root.Position+travel; model:PivotTo(CFrame.lookAt(pos,pos+direction.Unit)) end
    end
   end
   for i,limb in ipairs(e.Limbs) do limb.Part.CFrame=root.CFrame*limb.Offset*CFrame.Angles(moving and math.sin(os.clock()*10+i*math.pi)*.5 or 0,0,0) end
   if target and best&lt;(e.Def.Boss and 24 or 8) and os.clock()&gt;=e.NextAttack then
    e.NextAttack=os.clock()+(e.Def.Boss and 3.5 or 1.8); e.Windup=true
    local radius=e.Def.Boss and 22 or 9; local center=root.Position
    ctx.Feedback:FireAllClients("Warning",center,radius,e.Def.Boss and 1.2 or .65)
    task.delay(e.Def.Boss and 1.2 or .65,function()
     e.Windup=false; if not Enemies.Active[model] then return end
     for player,d in pairs(ctx.Profiles.Data) do
      local r=ctx.Runtime[player]; local hrp,hum=ctx.Character(player)
      if r and hrp and hum and not ctx.Profiles.Travel[player] and d.Floor==e.Def.Floor and r.Mode==e.Mode and os.clock()&gt;(r.Invulnerable or 0) and (r.Mode=="Dungeon" or not P.InTown(hrp.Position,d.Floor)) and (hrp.Position-center).Magnitude&lt;radius then
       local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={folder,hrp.Parent}
       if not workspace:Raycast(center,hrp.Position-center,params) then
        hum:TakeDamage(math.max(1,math.floor(e.Def.Damage*(1-P.Reduction(d))))); r.InCombatUntil=os.clock()+8; ctx.Animate(player,"Hurt",.35); ctx.Feedback:FireClient(player,"Hurt")
       end
      end
     end
    end)
   end
  end
 end)
end
return Enemies
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3869">
        <Properties>
          <string name="Name">Equipment</string>
          <ProtectedString name="Source">local V=require(game.ReplicatedStorage.LittleRPG.WeaponVisual)
local P=require(game.ReplicatedStorage.LittleRPG.Progression)
local E={}
function E.Give(player,data)
 local character=player.Character; local backpack=player:FindFirstChildOfClass("Backpack")
 if not character or not backpack then return end
 for _,parent in ipairs({character,backpack}) do for _,o in ipairs(parent:GetChildren()) do if o:IsA("Tool") and o:GetAttribute("LittleGear") then o:Destroy() end end end
 local weapon=P.Weapon(data,data.Equipped); if not weapon then return end
 local tool=V.Build(weapon,true); tool.Parent=backpack
 local hum=character:FindFirstChildOfClass("Humanoid"); if hum then hum:EquipTool(tool) end
end
return E
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX3870">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">-- ORQUESTRADOR. Todos os valores de dano, dinheiro, itens e recompensas são do servidor.
local Players=game:GetService("Players")
local Tween=game:GetService("TweenService")
local Shared=game.ReplicatedStorage:WaitForChild("LittleRPG")
local C=require(Shared.Config); local K=require(Shared.Catalog); local P=require(Shared.Progression); local E=require(Shared.Economy)
local Profiles=require(script.Parent.Profiles); local Equipment=require(script.Parent.Equipment); local Enemies=require(script.Parent.Enemies)
local WorldActions=require(script.Parent.WorldActions); local Dungeons=require(script.Parent.Dungeons); local Monetization=require(script.Parent.Monetization)
local folder=Instance.new("Folder"); folder.Name="Remotes"; folder.Parent=Shared
local function remote(name) local o=Instance.new("RemoteEvent"); o.Name=name; o.Parent=folder; return o end
local Action=remote("Action"); local State=remote("State"); local Feedback=remote("Feedback")
local ctx={Profiles=Profiles,Runtime={},Feedback=Feedback}
function ctx.Character(player)
 local char=player.Character; local root=char and char:FindFirstChild("HumanoidRootPart"); local hum=char and char:FindFirstChildOfClass("Humanoid")
 if root and hum and hum.Health&gt;0 then return root,hum end
end
function ctx.Speed(player)
 local d=Profiles.Data[player]; local r=ctx.Runtime[player]
 return d and P.Speed(d)*(r and r.Sprinting and r.Energy&gt;0 and 1.35 or 1) or 18
end
function ctx.Notice(player,message) if player.Parent then Feedback:FireClient(player,"Notice",message) end end
function ctx.Animate(player,name,duration)
 local char=player.Character; if not char then return end
 char:SetAttribute("ActionName",name); char:SetAttribute("ActionStart",workspace:GetServerTimeNow()); char:SetAttribute("ActionDuration",duration)
end
function ctx.Sync(player)
 local d=Profiles.Data[player]; local r=ctx.Runtime[player]; if not d or not r then return end
 local epoch=math.floor(os.time()/C.StockSeconds)
 if d.StockEpoch~=epoch then d.StockEpoch=epoch; d.StockBought={} end
 local stock=E.Stock(d.Floor,epoch)
 for _,offer in ipairs(stock) do offer.Count=math.max(0,offer.Count-(d.StockBought[d.Floor..":"..offer.Key] or 0)) end
 State:FireClient(player,{Level=d.Level,XP=d.XP,Required=P.Required(d.Level),Gold=d.Gold,Floor=d.Floor,Unlocked=d.Unlocked,StarterChosen=d.StarterChosen,
  Weapons=d.Weapons,Equipped=d.Equipped,Stats=d.Stats,Points=d.Points,ForgeXP=d.ForgeXP,ForgeSkill=P.ForgeSkill(d),Ores=d.Ores,Potions=d.Potions,Pickaxe=d.Pickaxe,
  Kills=d.Kills,Bosses=d.Bosses,Temporary=Profiles.Temporary,Mode=r.Mode,Stock=stock,StockEnds=(epoch+1)*C.StockSeconds,ServerTime=os.time(),Forging=d.PendingForge~=nil,Seals=r.Seals or {}})
 player:SetAttribute("Energy",math.floor(r.Energy)); player:SetAttribute("Floor",d.Floor); player:SetAttribute("GameMode",r.Mode)
 local stats=player:FindFirstChild("leaderstats"); if stats then stats:FindFirstChild("Nível").Value=d.Level end
end
function ctx.Prompt(part,action,title,callback)
 local prompt=Instance.new("ProximityPrompt"); prompt.ActionText=action; prompt.ObjectText=title; prompt.MaxActivationDistance=14; prompt.HoldDuration=.3; prompt.RequiresLineOfSight=false; prompt.Parent=part
 prompt.Triggered:Connect(function(player)
  local d=Profiles.Data[player]; local r=ctx.Runtime[player]; local root=ctx.Character(player)
  if not d or not r or not root or Profiles.Travel[player] or Profiles.Closing[player] or r.Forging or (root.Position-part.Position).Magnitude&gt;18 then return end
  if os.clock()&lt;(r.NextPrompt or 0) then return end; r.NextPrompt=os.clock()+.2
  callback(player)
 end)
 return prompt
end
function ctx.RespawnAt(player)
 local d=Profiles.Data[player]; local r=ctx.Runtime[player]; local root,hum=ctx.Character(player)
 if not d or not r or not root then return end
 local position=C.Floors[d.Floor].Origin+C.Floors[d.Floor].Spawn
 if r.Mode=="Dungeon" then position=workspace.LittleWorld.Interactions:FindFirstChild("DungeonExit_"..d.Floor).Position+Vector3.new(0,4,0) end
 player.Character:PivotTo(CFrame.new(position)); hum.Health=hum.MaxHealth; r.Energy=100; r.Sprinting=false; r.Seals={}; root.Anchored=false
 Feedback:FireClient(player,"Floor",d.Floor)
end
function ctx.OnKill(player,id)
 local d=Profiles.Data[player]; local r=ctx.Runtime[player]; local def=C.Enemies[id]
 if not d or not r or Profiles.Closing[player] then return end
 d.Kills=d.Kills+1; local gained=P.Grant(d,def.XP,def.Gold)
 if def.Boss and r.Mode=="Dungeon" then
  d.Bosses[id]=true; d.Unlocked=math.max(d.Unlocked,math.min(3,def.Floor+1))
  ctx.Notice(player,def.Floor==3 and "Soberano vencido! Você conquistou os três andares." or "Dungeon vencida! Novo andar liberado no elevador da cidade.")
 end
 if math.random()&lt;(def.Boss and C.DropChance.Boss or C.DropChance.Normal) then
  local rarity=E.Roll(C.DropWeights,math.random())
  local blueprint
  if rarity==7 and id=="sovereign" then blueprint="greatsword_10"
  else
   rarity=math.min(6,rarity); local pool={}
   for _,item in ipairs(K.List) do if item.Tier&lt;=math.min(9,def.Floor*3) then pool[#pool+1]=item.Id end end
   blueprint=pool[math.random(#pool)]
  end
  local weapon=P.AddWeapon(d,blueprint,rarity)
  if weapon then ctx.Notice(player,"DROP: "..K.Name(weapon)) else ctx.Notice(player,"Mochila cheia: não foi possível recolher a arma.") end
 end
 if gained&gt;0 then
  local _,hum=ctx.Character(player); if hum then hum.MaxHealth=P.MaxHP(d); hum.Health=hum.MaxHealth end
  Feedback:FireClient(player,"Level",d.Level,gained)
 end
 Feedback:FireClient(player,"Reward",def.XP,def.Gold); ctx.Sync(player)
end
WorldActions.Start(ctx); Dungeons.Start(ctx); Monetization.Start(Profiles,ctx.Sync,ctx.Notice); Enemies.Start(ctx)
-- Selos em becos diferentes exigem explorar o labirinto antes de acessar a arena.
for _,marker in ipairs(workspace.LittleWorld.Interactions:GetChildren()) do
 local floor,number=marker.Name:match("^Seal_(%d+)_(%d+)$")
 if floor then
  floor=tonumber(floor); number=tonumber(number)
  ctx.Prompt(marker,"Ativar selo","Mecanismo de pedra",function(player)
   local d=Profiles.Data[player]; local r=ctx.Runtime[player]
   if r.Mode=="Dungeon" and d.Floor==floor then r.Seals[number]=true; ctx.Animate(player,"Interact",.6); ctx.Notice(player,"Selo "..number.." ativado."); ctx.Sync(player) end
  end)
 end
 local arenaFloor=tonumber(marker.Name:match("^ArenaGate_(%d+)$"))
 if arenaFloor then
  ctx.Prompt(marker,"Abrir a arena","Portão dos três selos",function(player)
   local d=Profiles.Data[player]; local r=ctx.Runtime[player]
   if r.Mode~="Dungeon" or d.Floor~=arenaFloor then return end
   for i=1,3 do if not r.Seals[i] then ctx.Notice(player,"Encontre e ative os três selos do labirinto."); return end end
   player.Character:PivotTo(CFrame.new(C.DungeonX+520,C.Floors[arenaFloor].Origin.Y+6,55)); ctx.Notice(player,"O guardião espera.")
  end)
 end
end
local function setupCharacter(player,char)
 if char:GetAttribute("LittleSetup") then return end; char:SetAttribute("LittleSetup",true)
 local hum=char:WaitForChild("Humanoid",10); char:WaitForChild("HumanoidRootPart",10)
 while player.Parent and not Profiles.Data[player] do task.wait(.1) end
 local d=Profiles.Data[player]; if not d or not hum or not ctx.Runtime[player] then return end
 hum.MaxHealth=P.MaxHP(d); hum.Health=hum.MaxHealth; hum.WalkSpeed=ctx.Speed(player)
 ctx.RespawnAt(player); Equipment.Give(player,d); ctx.Sync(player)
end
local function join(player)
 ctx.Runtime[player]={Mode="World",Energy=100,Seals={}}
 player.CharacterAdded:Connect(function(char) setupCharacter(player,char) end)
 local d=Profiles.Load(player); if not d then return end
 if not player.Parent then Profiles.Close(player); return end
 if not Dungeons.Arrive(player,d) then return end
 local stats=Instance.new("Folder"); stats.Name="leaderstats"; stats.Parent=player
 local level=Instance.new("IntValue"); level.Name="Nível"; level.Value=d.Level; level.Parent=stats
 if player.Character then task.spawn(setupCharacter,player,player.Character) end
 ctx.Sync(player)
end
Players.PlayerAdded:Connect(join); for _,player in ipairs(Players:GetPlayers()) do task.spawn(join,player) end
Players.PlayerRemoving:Connect(function(player) ctx.Runtime[player]=nil end)
Action.OnServerEvent:Connect(function(player,verb,arg)
 if type(verb)~="string" then return end
 local r=ctx.Runtime[player]; if not r then return end
 if verb=="Sprint" and arg==false then r.Sprinting=false; local _,hum=ctx.Character(player); if hum then hum.WalkSpeed=ctx.Speed(player) end; return end
 local now=os.clock(); if now&lt;(r.NextRemote or 0) then return end; r.NextRemote=now+.08
 if verb=="Ready" then ctx.Sync(player); return end
 local d=Profiles.Data[player]; local root,hum=ctx.Character(player)
 if not d or not root or Profiles.Travel[player] or Profiles.Closing[player] then return end
 if verb=="Choose" then if type(arg)=="string" and P.Choose(d,arg) then Equipment.Give(player,d); ctx.Sync(player) end; return end
 if not d.StarterChosen then return end
 if verb=="Allocate" then
  if type(arg)=="string" and P.Allocate(d,arg) then hum.MaxHealth=P.MaxHP(d); hum.WalkSpeed=ctx.Speed(player); ctx.Sync(player) end
 elseif verb=="Equip" then
  if r.Forging or now&lt;(r.NextEquip or 0) then return end
  local weapon=type(arg)=="string" and P.Weapon(d,arg)
  if weapon and d.Level&gt;=K.ById[weapon.Blueprint].Level then d.Equipped=weapon.Uid; r.NextEquip=now+.5; Equipment.Give(player,d); ctx.Sync(player) end
 elseif verb=="Attack" or verb=="Special" then
  if r.Forging or r.Dashing or (r.Mode=="World" and P.InTown(root.Position,d.Floor)) then return end
  local weapon=P.Weapon(d,d.Equipped); local tool=player.Character:FindFirstChildOfClass("Tool")
  if not weapon or not tool or tool:GetAttribute("WeaponUid")~=weapon.Uid then return end
  local item=K.ById[weapon.Blueprint]; local special=verb=="Special"
  if now&lt;(r.NextAttack or 0) or (special and (now&lt;(r.NextSpecial or 0) or r.Energy&lt;item.Energy)) then return end
  r.NextAttack=now+item.Cooldown
  if special then r.NextSpecial=now+item.SpecialCooldown; r.Energy=r.Energy-item.Energy; ctx.Sync(player) end
  r.Combo=(r.Combo or 0)%3+1; ctx.Animate(player,special and item.Style or "Attack"..r.Combo,math.min(.6,item.Cooldown))
  Feedback:FireAllClients("Swing",player.UserId,special,item.Style); r.InCombatUntil=now+6
  local candidates={}
  for model,e in pairs(Enemies.Active) do
   if e.Mode==r.Mode and e.Def.Floor==d.Floor then
    local delta=model.PrimaryPart.Position-root.Position; local dist=delta.Magnitude
    if dist&gt;0 and dist&lt;item.Range+(special and 4 or 0) and root.CFrame.LookVector:Dot(delta.Unit)&gt;(special and -.15 or .05) then candidates[#candidates+1]={Model=model,Dist=dist} end
   end
  end
  table.sort(candidates,function(a,b) return a.Dist&lt;b.Dist end)
  local count=0
  for _,target in ipairs(candidates) do
   local model=target.Model; local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={player.Character}
   local hit=workspace:Raycast(root.Position,model.PrimaryPart.Position-root.Position,params)
   if not hit or hit.Instance:IsDescendantOf(model) then Enemies.Hit(player,model,K.Damage(weapon,d.Level,d.Stats.Forca,special)); count=count+1 end
   if count&gt;=(special and (item.Style=="Slam" or item.Style=="Cleave") and 3 or 1) then break end
  end
 elseif verb=="Dash" then
  if r.Forging or r.Dashing or now&lt;(r.NextDash or 0) or r.Energy&lt;18 then return end
  r.NextDash=now+2.2; r.Energy=r.Energy-18; r.Invulnerable=now+.22; r.Dashing=true
  local direction=hum.MoveDirection.Magnitude&gt;.1 and hum.MoveDirection.Unit or root.CFrame.LookVector
  direction=Vector3.new(direction.X,0,direction.Z).Unit
  local distance=P.Dash(d); local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={player.Character}
  local obstruction=workspace:Blockcast(root.CFrame,Vector3.new(3,4,2),direction*distance,params)
  if obstruction then distance=math.max(0,obstruction.Distance-2) end
  pcall(function() root:SetNetworkOwner(nil) end)
  Tween:Create(root,TweenInfo.new(.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame=root.CFrame+direction*distance}):Play()
  ctx.Animate(player,"Dash",.25); ctx.Sync(player)
  task.delay(.22,function() r.Dashing=false; if root.Parent then pcall(function() root:SetNetworkOwner(player) end) end end)
 elseif verb=="Sprint" then r.Sprinting=arg==true; hum.WalkSpeed=ctx.Speed(player)
 elseif verb=="Travel" then
  if r.Mode~="World" or now&lt;(r.InCombatUntil or 0) or r.Forging or not P.CanTravel(d,arg) then return end
  local marker=workspace.LittleWorld.Interactions:FindFirstChild("Travel_"..d.Floor)
  if not marker or (root.Position-marker.Position).Magnitude&gt;20 then return end
  d.Floor=arg; ctx.RespawnAt(player); ctx.Sync(player)
 elseif not r.Forging then WorldActions.Action(player,verb,arg) end
end)
task.spawn(function()
 local stockEpoch=math.floor(os.time()/C.StockSeconds)
 while task.wait(1) do
  local epoch=math.floor(os.time()/C.StockSeconds); local refresh=epoch~=stockEpoch; stockEpoch=epoch
  for player,d in pairs(Profiles.Data) do
   local r=ctx.Runtime[player]; local root,hum=ctx.Character(player)
   if r and root and not Profiles.Travel[player] then
    if r.Sprinting and hum.MoveDirection.Magnitude&gt;.1 then r.Energy=math.max(0,r.Energy-5); if r.Energy==0 then r.Sprinting=false end else r.Energy=math.min(100,r.Energy+8) end
    hum.WalkSpeed=ctx.Speed(player); player:SetAttribute("Energy",math.floor(r.Energy))
    local y=C.Floors[d.Floor].Origin.Y
    local outside=r.Mode=="World" and (math.abs(root.Position.X)&gt;850 or math.abs(root.Position.Z)&gt;650) or r.Mode=="Dungeon" and (root.Position.X&lt;C.DungeonX-240 or root.Position.X&gt;C.DungeonX+610 or math.abs(root.Position.Z)&gt;240)
    if root.Position.Y&lt;y-50 or root.Position.Y&gt;y+120 or outside then ctx.RespawnAt(player); hum:TakeDamage(hum.MaxHealth*.1)
    elseif r.Mode=="World" and P.InTown(root.Position,d.Floor) then hum.Health=math.min(hum.MaxHealth,hum.Health+hum.MaxHealth*.03) end
    if refresh then ctx.Sync(player) end
   end
  end
 end
end)
</ProtectedString>
